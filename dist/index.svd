<?xml version="1.0" encoding="UTF-8"?>
<svg
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    width="100%"
    height="100%"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
>
    <foreignObject
        x="0"
        y="0"
        width="100%"
        height="100%"
    >
        <body
            xmlns="http://www.w3.org/1999/xhtml"
            style="
                margin: 0;
                padding: 0;
                width: 100vw;
                height: 100vh;
                overflow: hidden;
                background: #000;
            "
        >
            <iframe
                src="./index.html"
                style="
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100vw;
                    height: 100vh;
                    border: 0;
                    margin: 0;
                    padding: 0;
                "
                allow="fullscreen"
            ></iframe>
        </body>
    </foreignObject>
</svg>